{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://write-now-publishing-house.local/schemas/mockup-generation-job-v1.json",
  "title": "WNPH Mockup Generation Job v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "editionId",
    "packageVersion",
    "template",
    "physical",
    "artwork",
    "outputs"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "editionId": { "type": "string", "minLength": 1 },
    "packageVersion": { "type": "integer", "minimum": 1 },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "version"],
      "properties": {
        "family": {
          "enum": ["paperback", "cloth-hardcover", "printed-casewrap-hardcover", "dust-jacket-hardcover"]
        },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "physical": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding", "construction", "trim"],
      "properties": {
        "binding": { "enum": ["paperback", "hardcover"] },
        "construction": {
          "enum": ["paperback-wrap", "cloth-case", "printed-casewrap", "dust-jacket"]
        },
        "trim": {
          "type": "object",
          "additionalProperties": false,
          "required": ["widthIn", "heightIn"],
          "properties": {
            "widthIn": { "type": "number", "exclusiveMinimum": 0 },
            "heightIn": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "pageCount": { "type": "integer", "minimum": 1 },
        "spineWidthIn": { "type": "number", "exclusiveMinimum": 0 },
        "coverStock": { "type": "string", "minLength": 1 },
        "caseMaterial": { "type": "string", "minLength": 1 },
        "jacketStock": { "type": "string", "minLength": 1 },
        "pageStock": { "type": "string", "minLength": 1 },
        "surfaceFinish": { "type": "string", "minLength": 1 }
      }
    },
    "artwork": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frontCover"],
      "properties": {
        "frontCover": { "$ref": "#/$defs/asset" },
        "backCover": { "$ref": "#/$defs/asset" },
        "spine": { "$ref": "#/$defs/asset" },
        "fullWrap": { "$ref": "#/$defs/asset" },
        "jacketSpread": { "$ref": "#/$defs/asset" },
        "caseFront": { "$ref": "#/$defs/asset" },
        "caseSpine": { "$ref": "#/$defs/asset" },
        "caseBack": { "$ref": "#/$defs/asset" }
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "shelfSpine",
          "frontCover",
          "threeQuarterMockup",
          "detailMockup",
          "jacketOffMockup",
          "backCover"
        ]
      }
    },
    "render": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "background": { "enum": ["transparent", "neutral"] },
        "targetPixelRatio": { "type": "number", "exclusiveMinimum": 0 },
        "notes": { "type": "string" }
      }
    }
  },
  "$defs": {
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "mediaType"],
      "properties": {
        "uri": { "type": "string", "minLength": 1 },
        "mediaType": { "type": "string", "minLength": 1 },
        "sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        }
      }
    }
  }
}
